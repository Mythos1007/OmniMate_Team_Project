# OmniMate secrets/config (example)
# Copy to .env (or export in shell) and set real values.

# Weather API key (KMA data.go.kr)
ASSISTANT_WEATHER_API_KEY=

# Optional: path to JSON secrets file (default: ~/.config/assistant_gui/secrets.json)
# ASSISTANT_WEATHER_SECRETS_FILE=~/.config/assistant_gui/secrets.json
