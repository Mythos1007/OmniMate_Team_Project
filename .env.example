# OmniMate secrets/config (example)
# Copy to .env (or export in shell) and set real values.

# Shared secrets JSON path for weather + voice engines
ASSISTANT_SECRETS_FILE=~/.config/assistant/secrets.json

# Optional direct env override values (leave empty when using secrets file)
ASSISTANT_WEATHER_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# Optional per-module secrets file overrides
# ASSISTANT_WEATHER_SECRETS_FILE=~/.config/assistant/secrets.json
# ASSISTANT_TTS_SECRETS_FILE=~/.config/assistant/secrets.json
