<?xml version="1.0"?>
<package format="3">
  <name>assistant_robot</name>
  <version>0.1.0</version>
  <description>Robot task execution, safety, navigation, and status services for the assistant robot.</description>
  <maintainer email="todo@example.com">mythos</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>assistant_interfaces</depend>
  <depend>action_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
